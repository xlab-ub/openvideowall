[Unit]
Description=Multi-Screen Client 1 (UB_3S_1)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME_DIR__/openvideowall/client
Environment=DISPLAY=:0
Environment=SDL_VIDEODRIVER=x11
EnvironmentFile=__HOME_DIR__/openvideowall/client/.env
ExecStart=__HOME_DIR__/openvideowall/client/start_client1.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__HOME_DIR__/openvideowall/client

[Install]
WantedBy=graphical.target