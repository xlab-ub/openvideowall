[Unit]
Description=Multi-Screen Client 1 (UB_3S_1)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME_DIR__/openvideowall/client
Environment=DISPLAY=:0
Environment=SDL_VIDEODRIVER=x11
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XAUTHORITY=__HOME_DIR__/.Xauthority
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=__HOME_DIR__/openvideowall/client/.env
ExecStartPre=/bin/sh -c 'for i in $(seq 1 20); do [ -S /tmp/.X11-unix/X0 ] && [ -d /run/user/%U ]; if [ $? -eq 0 ]; then exit 0; fi; sleep 1; done; exit 1'
ExecStart=__HOME_DIR__/openvideowall/client/start_client1.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__HOME_DIR__/openvideowall/client

[Install]
WantedBy=graphical.target