# Multi-Screen Client Environment Configuration
# Copy this file to .env and customize the values
# ALL VARIABLES ARE REQUIRED - NO DEFAULTS

# Client 1 Configuration
CLIENT1_SERVER_URL=http://192.168.1.100:5000
CLIENT1_HOSTNAME=UB_3S_1
CLIENT1_DISPLAY_NAME=UB_3S_1
CLIENT1_MONITOR_INDEX=0
CLIENT1_MONITOR_LOCATION=left

# Client 2 Configuration (for delayed startup)
CLIENT2_SERVER_URL=http://192.168.1.100:5000
CLIENT2_HOSTNAME=UB_3S_2
CLIENT2_DISPLAY_NAME=UB_3S_2
CLIENT2_MONITOR_INDEX=1
CLIENT2_MONITOR_LOCATION=right
CLIENT2_STARTUP_DELAY=30

# Alternative configurations for different environments:

# Development
# SERVER_URL=http://localhost:5000
# HOSTNAME=DEV_MONITOR_1
# DISPLAY_NAME="Development Monitor 1"

# Production
# SERVER_URL=http://production-server:5000
# HOSTNAME=PROD_MONITOR_1
# DISPLAY_NAME="Production Monitor 1"

# Office Environment
# SERVER_URL=http://192.168.1.200:5000
# HOSTNAME=OFFICE_DISPLAY_1
# DISPLAY_NAME="Office Display 1"
# MONITOR_INDEX=2
# MONITOR_LOCATION=center
