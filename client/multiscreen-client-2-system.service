[Unit]
Description=Multi-Screen Client 2 (UB_3S_2)
After=graphical-session.target openvideowall-client-1.service
Wants=graphical-session.target
Requires=openvideowall-client-1.service

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME_DIR__/openvideowall/client
Environment=DISPLAY=:0
Environment=SDL_VIDEODRIVER=x11
EnvironmentFile=__HOME_DIR__/openvideowall/client/.env
ExecStart=__HOME_DIR__/openvideowall/client/start_client2_delayed.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__HOME_DIR__/openvideowall/client

[Install]
WantedBy=graphical.target
